{
  "name": "capiumbrowser",
  "version": "1.0.0",
  "description": "Drop-in stealth browser SDK on top of Playwright or Puppeteer (Capium Chromium).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Capzy (https://capzy.ai)",
  "homepage": "https://capiumbrowser.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capzy-ai/capiumbrowser.git",
    "directory": "capiumbrowser-node"
  },
  "bugs": {
    "url": "https://github.com/capzy-ai/capiumbrowser/issues"
  },
  "keywords": [
    "playwright",
    "puppeteer",
    "stealth",
