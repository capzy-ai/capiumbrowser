    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "tar": "^7.4.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0",
    "puppeteer-core": ">=21.0.0"
